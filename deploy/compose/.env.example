# Copy this file to /opt/campus-fruit/.env on ECS and replace every placeholder.
DB_PASSWORD=replace-with-a-long-random-password
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret
IMAGE_REGISTRY=registry.cn-example.aliyuncs.com
IMAGE_NAMESPACE=your-acr-namespace
BAIDU_SERVER_AK=

# Only the frontend needs a public port. Leave the service ports unchanged unless required.
WEB_PORT=80
